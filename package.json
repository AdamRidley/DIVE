{
  "name": "dive-video",
  "version": "1.0.0",
  "description": "DIVE is a framework for creating Interruptible Narrative Visualizations (INV). A <dive-video> web component that bridges curated data stories and interactive exploration.",
  "type": "module",
  "main": "./dist/dive.js",
  "module": "./dist/dive.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/dive.js",
  "jsdelivr": "./dist/dive.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/dive.js",
      "default": "./dist/dive.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "DIVE-framework-spec.md"
  ],
  "sideEffects": true,
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run typecheck",
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.dts.json",
    "build:example": "vite build -c examples/the_wealth_and_health_of_nations/vite.config.example.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "validate:story": "node scripts/validate-story.mjs",
    "pack:dive": "node scripts/pack-dive.mjs",
    "test:ci": "npm run typecheck && npm run validate:story && npm run build && npm run check:dist",
    "prepublishOnly": "npm run test:ci",
    "build:wealth-health-data": "node examples/the_wealth_and_health_of_nations/scripts/build-gapminder-data.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AdamRidley/DIVE.git"
  },
  "keywords": [
    "dive",
    "inv",
    "visualization",
    "narrative",
    "web-component",
    "lit",
    "d3"
  ],
  "author": "Adam Ridley",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/AdamRidley/DIVE/issues"
  },
  "homepage": "https://github.com/AdamRidley/DIVE#readme",
  "dependencies": {
    "d3": "^7.9.0",
    "lit": "^3.3.2"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "typescript": "^5.9.3",
    "vite": "^8.0.1"
  }
}
